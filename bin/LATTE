#!/bin/bash

#
bam_file=""
list_bam_files=""
te_gff=""
output_prefix=""
thread=1
overlap=0.5
expectation=0.8
max_iterations_outer=10
max_iterations_inner=10
abe_step="False"
# script_dir=$(cd $(dirname $0);pwd)
# development 
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; # echo $SCRIPT_DIR
PARENT_DIR="$(dirname "$SCRIPT_DIR")"
reserve_tmp_dir="False"

# parameter
usage() {
        echo "Usage: $0" 
        echo "      -b  <BAM file (sorted)>" 
        echo "      -l  <List of BAM files (absolute path required, one per line, no space), restricted by -b>" 
        echo "      -g  <TE annotation file (format as RepeatMasker.GFF)>"
        echo "      -o  <Output prefix> (default: working directory)"
        echo "      -t  <Multiple threads for List of BAM files, restricted by -b> (default: 1)"
        echo "      -f  <Minimum overlap requirement> (default: 0.5)"
        echo "      -p  <Maximum likelihood value for assignment> (default: 0.8)"
        echo "      -m  <Maximum iterations of the outer cycle> (default: 10)"
        echo "      -M  <Maximum iterations of the inner cycle> (default: 10)"  
        echo "      -e  <Abnormal ERV detection> (default: Flase)"
        echo "      -v  <Show version information>"
        echo "      -h  <Show this help message>"   
        exit 0
}

# getopts
while getopts ":b:l:g:o:t:f:m:M:p:ezvh" opt; do
    case $opt in
        b)
            bam_file="$OPTARG"
            ;;
        l)
            list_bam_files="$OPTARG"
            ;;        
        g)
            te_gff="$OPTARG"
            ;;
        o)
            output_prefix="$OPTARG"
            ;;
        t)
            thread="$OPTARG"
            ;;
        f)
            overlap="$OPTARG"
            ;;
        p)
            expectation="$OPTARG"
            ;;
        e)
            abe_step="True"
            ;;
        m)
            max_iterations_outer="$OPTARG"
            ;;
        M)
            max_iterations_inner="$OPTARG"
            ;;
        z)
            reserve_tmp_dir="True"
            ;;
        v) echo "Version 1.0.8" && exit 0 ;;
        h) usage ;;
        :)
            echo "The option -$OPTARG requires a parameter."
            usage
            ;;
        *)
            usage
            ;;
    esac
done

# 
shift $((OPTIND - 1))
# checking the necessary parameters
if [[ ! -z "$bam_file" ]] && [[ ! -z "$list_bam_files" ]]; then
    echo "Error: both <-b> and <-l> are provided, please choose one"    
    usage
elif [[ -z "$te_gff" ]] && { [[ -z "$bam_file" ]] || [[ -z "$list_bam_files" ]]; }; then
    echo "Error: <-g> is required, and either <-b> or <-l> must be provided"
    usage
elif [[ ! -e "$te_gff" ]] && { [[ ! -e "$bam_file" ]] || [[ -e "$list_bam_files" ]]; }; then
    echo "Error： no such <BAM file> or <List of BAM files> or <TE annotation file>"
    usage
fi

# check the required tools
if [[ ! $(samtools --version) ]] && [[ ! $(bedtools --version) ]]; then
    echo "Error: samtools and bedtools are not in PATH"
    exit 0
elif [[ ! $(samtools --version) ]]; then
    echo "Error: samtools is not in PATH"
    exit 0
elif [[ ! $(bedtools --version) ]]; then
    echo "Error: bedtools is not in PATH"
    exit 0
fi

# check file exist and convert to absolute path (in case)
[[ ! -z ${bam_file} ]] && if [[ -f "$bam_file" ]]; then
    absPathBamFile=$(readlink -f "$bam_file")
    bam_file=$absPathBamFile
else
    echo "Error: <BAM file: ${bam_file} > is not exist"
    exit 0
fi
[[ ! -z $list_bam_files ]] && if [[ -f "$list_bam_files" ]]; then
    absPathListBamFiles=$(readlink -f "$list_bam_files")
    list_bam_files=$absPathListBamFiles
else
    echo "Error: <List of BAM files: ${list_bam_files} > is not exist"
    exit 0
fi
if [[ -f "$te_gff" ]]; then
    absPathTeGff=$(readlink -f "$te_gff")
    te_gff=$absPathTeGff
else
    echo "Error: <TE annotation file: ${te_gff} > is not exist"
    exit 0
fi


# convert each line in list_bam_files to absolute path
[[ ! -z $list_bam_files ]] && abs_paths_str=""
[[ ! -z $list_bam_files ]] && [[ -f ${output_prefix}_tmp_LATTE_BAMAbsPath ]] && rm ${output_prefix}_tmp_LATTE_BAMAbsPath
[[ ! -z $list_bam_files ]] && while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    abs_path="$(readlink -f "$line")"
    # if the BamFile in list is not exist, continue
    if [[ ! -f ${abs_path} ]]; then
        echo "[file not exist; continue] ${line}"
        continue
    fi
    echo ${abs_path} >> ${output_prefix}_tmp_LATTE_BAMAbsPath
    # if [[ -z "$abs_paths_str" ]]; then
    #     abs_paths_str="$abs_path"
    # else
    #     abs_paths_str="${abs_paths_str}\n${abs_path}"
    # fi
done < "$list_bam_files"

# check the validity of the list of BAM files (by size)
[[ ! -z $list_bam_files ]] && if [[ ! -s ${output_prefix}_tmp_LATTE_BAMAbsPath ]]; then
    echo "Error: no valid <absolute paths of BAM files> in <List of BAM files>, please check"
    exit 0
fi

# check repeat names in list of BAM files  
if [[ ! -z $list_bam_files ]] && [[ -f ${output_prefix}_tmp_LATTE_BAMAbsPath ]]; then
    awk -F'/' '{count[$NF]++} END {for (name in count) {if (count[name] > 1) print "Error: repeat name in <list of BAM files> " name }}' ${output_prefix}_tmp_LATTE_BAMAbsPath
    if ! awk -F'/' '{count[$NF]++} END {for (name in count) {if (count[name] > 1) exit 1}}' ${output_prefix}_tmp_LATTE_BAMAbsPath; then
        echo "Error: no repeat names allowed in <list of BAM files>"
        exit 0
    fi
fi

# check the GFF format
if ! awk -v FS="\t" '
(NR == 1) || (/#/) { next }
{
    if ( ($4 !~ /^[0-9]+([.][0-9]+)?$/) || ($5 !~ /^[0-9]+([.][0-9]+)?$/) ) {
        exit 1
    }
    num = split($9, arr, " ")
    if (num != 4) {
        exit 1
    }
}' "${te_gff}"; then
    echo "Error: invalid format of <TE.gff>, please check"
    exit 0
elif awk -v FS="\t" '
(NR == 1) || (/#/) { next }
{
    if ($9 ~ /rich|\)n/) {
        exit 0
    }
}' "${te_gff}"; then
    echo "Warning: low-complexity sequence in the <TE.gff> file, recommend to remove"
fi

# # check the chromosome match between BAM and GFF 
# [[ ! -z $bam_file ]] && bam_for_check=$bam_file
# [[ ! -z $list_bam_files ]] && bam_for_check=$(head -n1 ${output_prefix}_tmp_LATTE_BAMAbsPath)

# check output prefix
if [[ -z ${output_prefix} ]] && [[ ! -z ${bam_file} ]]; then
    # default output prefix: working directory + BAM file name
    output_prefix=$(pwd | sed "s/$/\/$(basename $bam_file)&/g")
elif [[ -z ${output_prefix} ]] && [[ ! -z ${list_bam_files} ]]; then
    # default output prefix: working directory
    output_prefix=$(pwd | sed "s/$/\//")
elif [[ ! -z ${output_prefix} ]] && [[ ! -z ${bam_file} ]]; then
    # output directory check
    absPathOutput=$(dirname ${output_prefix})
    if [ ! -d "$absPathOutput" ] ; then
        echo "Error: no such <output directory>"
        usage
    fi
    absPathPrefix=$(readlink -f "$output_prefix")
    if [ ${absPathPrefix} == $(pwd) ] ; then
        output_prefix=$(pwd | sed "s/$/\/$(basename $bam_file)&/g")
    else
        output_prefix=$absPathPrefix
    fi
elif [[ ! -z ${output_prefix} ]] && [[ ! -z ${list_bam_files} ]]; then
    # output directory check
    absPathOutput=$(dirname ${output_prefix})
    if [ ! -d "$absPathOutput" ] ; then
        echo "Error: no such <output directory>"
        usage
    fi
    absPathPrefix=$(readlink -f "$output_prefix")
    if [ ${absPathPrefix} == $(pwd) ] ; then
        output_prefix=$(pwd | sed "s/$/\//")
    else
        output_prefix=$absPathPrefix
    fi
else
    echo "Error: <output prefix> is not valid"
    usage
fi

# # print the parameters
# echo "[Parameters:]"
# echo ${bam_file} ${list_bam_files} ${te_gff} ${output_prefix} ${thread} ${overlap} ${expectation} ${max_iterations_outer} ${max_iterations_inner} ${abe_step} ${SCRIPT_DIR} ${PARENT_DIR} ${reserve_tmp_dir} | awk '{for(i=1;i<=NF;i++) printf "\t%s\n", $i}'

# execute
[[ ! -z ${bam_file} ]] && echo "[BaseMode]" && bash ${PARENT_DIR}/scripts/base_mode.sh ${bam_file} "NA" ${te_gff} ${output_prefix} ${thread} ${overlap} ${expectation} ${max_iterations_outer} ${max_iterations_inner} ${abe_step} ${SCRIPT_DIR} ${PARENT_DIR} ${reserve_tmp_dir}
[[ ! -z ${list_bam_files} ]] && echo "[BatchMode]" && bash ${PARENT_DIR}/scripts/batch_mode.sh "NA" ${output_prefix}_tmp_LATTE_BAMAbsPath ${te_gff} ${output_prefix} ${thread} ${overlap} ${expectation} ${max_iterations_outer} ${max_iterations_inner} ${abe_step} ${SCRIPT_DIR} ${PARENT_DIR} ${reserve_tmp_dir} && rm ${output_prefix}_tmp_LATTE_BAMAbsPath

